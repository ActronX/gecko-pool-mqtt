# Gecko / OAuth
# Public PKCE client of Gecko Alliance without a client secret. Not a
# secret; override only when you register your own.
GECKO_OAUTH2_CLIENT_ID=L81oh6hgUsvMg40TgTGoz4lxNy8eViM0
GECKO_AUTH0_URL_BASE=https://gecko-prod.us.auth0.com
GECKO_API_BASE_URL=https://api.geckowatermonitor.com
OAUTH_REDIRECT_URI=https://my.home-assistant.io/redirect/oauth
OAUTH_TOKEN_FILE=/data/tokens.json
# GECKO_ACCOUNT_ID=
# GECKO_MONITOR_ID=
GECKO_CONFIG_TIMEOUT=30.0
GECKO_HEAT_PUMP_FLOW_ZONE_ID=4
GECKO_HEAT_PUMP_DEFAULT_DURATION=30
# 0 = unlimited reassert attempts without emergency shutdown
GECKO_HEAT_PUMP_MAX_REASSERT_ATTEMPTS=2
GECKO_HEAT_PUMP_CHECK_INTERVAL=5.0
GECKO_HEAT_PUMP_CONFIRM_TIMEOUT=15.0
LOG_LEVEL=INFO

# Local MQTT
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_BASE_TOPIC=geeko
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_CLIENT_ID=geeko-pool-mqtt
# Wait time during clean shutdown until retained "offline" is confirmed
MQTT_SHUTDOWN_PUBLISH_TIMEOUT=2.0
# Capture all local MQTT messages as JSONL, one file per UTC day.
# Empty or off disables it. docker-compose.yml binds /tmp/mqtt to
# ./mqtt-trace in the project directory.
MQTT_TRACE_DIR=/tmp/mqtt
# 0 = retain indefinitely
MQTT_TRACE_RETENTION_DAYS=7
